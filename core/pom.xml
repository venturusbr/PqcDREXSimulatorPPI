<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>br.org.venturus</groupId>
    <artifactId>drexsim-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>drexsim-core</artifactId>
  <name>PQC DREX Simulator - core</name>
  <description>Post-quantum transaction signing, Drex contract client and balance viewer</description>

  <properties>
    <!-- ABI and bytecode exported by contracts/ (npm run export); committed so Java builds without Node. -->
    <contracts.build.dir>${project.basedir}/../contracts/build</contracts.build.dir>
    <generated.dir>${project.build.directory}/generated-sources/web3j</generated.dir>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.web3j</groupId>
      <artifactId>core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk18on</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
    </dependency>
    <dependency>
      <groupId>info.picocli</groupId>
      <artifactId>picocli</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Generates one web3j wrapper per Drex contract from contracts/build. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <mainClass>org.web3j.codegen.SolidityFunctionWrapperGenerator</mainClass>
          <includeProjectDependencies>false</includeProjectDependencies>
          <includePluginDependencies>true</includePluginDependencies>
          <blockSystemExit>true</blockSystemExit>
        </configuration>
        <executions>
          <execution>
            <id>wrap-RealDigital</id>
            <phase>generate-sources</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <arguments>
                <argument>-a</argument><argument>${contracts.build.dir}/RealDigital.abi</argument>
                <argument>-b</argument><argument>${contracts.build.dir}/RealDigital.bin</argument>
                <argument>-o</argument><argument>${generated.dir}</argument>
                <argument>-p</argument><argument>br.org.venturus.drexsim.contracts</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>wrap-RealTokenizado</id>
            <phase>generate-sources</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <arguments>
                <argument>-a</argument><argument>${contracts.build.dir}/RealTokenizado.abi</argument>
                <argument>-b</argument><argument>${contracts.build.dir}/RealTokenizado.bin</argument>
                <argument>-o</argument><argument>${generated.dir}</argument>
                <argument>-p</argument><argument>br.org.venturus.drexsim.contracts</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>wrap-STR</id>
            <phase>generate-sources</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <arguments>
                <argument>-a</argument><argument>${contracts.build.dir}/STR.abi</argument>
                <argument>-b</argument><argument>${contracts.build.dir}/STR.bin</argument>
                <argument>-o</argument><argument>${generated.dir}</argument>
                <argument>-p</argument><argument>br.org.venturus.drexsim.contracts</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>wrap-SwapOneStep</id>
            <phase>generate-sources</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <arguments>
                <argument>-a</argument><argument>${contracts.build.dir}/SwapOneStep.abi</argument>
                <argument>-b</argument><argument>${contracts.build.dir}/SwapOneStep.bin</argument>
                <argument>-o</argument><argument>${generated.dir}</argument>
                <argument>-p</argument><argument>br.org.venturus.drexsim.contracts</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>wrap-SwapTwoSteps</id>
            <phase>generate-sources</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <arguments>
                <argument>-a</argument><argument>${contracts.build.dir}/SwapTwoSteps.abi</argument>
                <argument>-b</argument><argument>${contracts.build.dir}/SwapTwoSteps.bin</argument>
                <argument>-o</argument><argument>${generated.dir}</argument>
                <argument>-p</argument><argument>br.org.venturus.drexsim.contracts</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>wrap-RealDigitalEnableAccount</id>
            <phase>generate-sources</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <arguments>
                <argument>-a</argument><argument>${contracts.build.dir}/RealDigitalEnableAccount.abi</argument>
                <argument>-b</argument><argument>${contracts.build.dir}/RealDigitalEnableAccount.bin</argument>
                <argument>-o</argument><argument>${generated.dir}</argument>
                <argument>-p</argument><argument>br.org.venturus.drexsim.contracts</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>wrap-RealDigitalDefaultAccount</id>
            <phase>generate-sources</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <arguments>
                <argument>-a</argument><argument>${contracts.build.dir}/RealDigitalDefaultAccount.abi</argument>
                <argument>-b</argument><argument>${contracts.build.dir}/RealDigitalDefaultAccount.bin</argument>
                <argument>-o</argument><argument>${generated.dir}</argument>
                <argument>-p</argument><argument>br.org.venturus.drexsim.contracts</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>wrap-KeyDictionary</id>
            <phase>generate-sources</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <arguments>
                <argument>-a</argument><argument>${contracts.build.dir}/KeyDictionary.abi</argument>
                <argument>-b</argument><argument>${contracts.build.dir}/KeyDictionary.bin</argument>
                <argument>-o</argument><argument>${generated.dir}</argument>
                <argument>-p</argument><argument>br.org.venturus.drexsim.contracts</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>wrap-AddressDiscovery</id>
            <phase>generate-sources</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <arguments>
                <argument>-a</argument><argument>${contracts.build.dir}/AddressDiscovery.abi</argument>
                <argument>-b</argument><argument>${contracts.build.dir}/AddressDiscovery.bin</argument>
                <argument>-o</argument><argument>${generated.dir}</argument>
                <argument>-p</argument><argument>br.org.venturus.drexsim.contracts</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
        <dependencies>
          <dependency>
            <groupId>org.web3j</groupId>
            <artifactId>codegen</artifactId>
            <version>${web3j.version}</version>
          </dependency>
        </dependencies>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>add-web3j-sources</id>
            <phase>generate-sources</phase>
            <goals><goal>add-source</goal></goals>
            <configuration>
              <sources><source>${generated.dir}</source></sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Runnable jar: java -jar core/target/drexsim.jar -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <finalName>drexsim</finalName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>br.org.venturus.drexsim.cli.DrexSimCli</mainClass>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <!-- Bouncy Castle is signed; its signature files are invalid inside a merged jar. -->
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- Network tests run only with -Ddrexsim.rpc=http://localhost:8545 (see README). -->
          <systemPropertyVariables>
            <drexsim.rpc>${drexsim.rpc}</drexsim.rpc>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
